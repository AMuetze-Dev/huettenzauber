# Kopieren nach .env und anpassen. Alle Werte haben Defaults (siehe docker-compose*.yml).

POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=huettenzauber

# Kommagetrennte erlaubte Browser-Origins fuer die API.
# Dev-Default: http://localhost:3000,http://localhost
# Prod (Pi ueber IP): z. B. http://192.168.4.1
CORS_ORIGINS=http://localhost:3000,http://localhost

# --- nur Produktion (Raspberry Pi) ---
# Zugangscode fuer schreibende Endpunkte. Leer = kein Schutz.
ACCESS_CODE=
# Wohin der Tagesabschluss seine pg_dump-Sicherungen legt (Host-Pfad).
BACKUP_HOST_DIR=./backups
